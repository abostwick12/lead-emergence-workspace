# Public, non-secret Workspace configuration.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
NEXT_PUBLIC_WORKSPACE_SCHEMA=workspace
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Gate C must keep this false until the authenticated Storage API lifecycle test passes.
NEXT_PUBLIC_WORKSPACE_UPLOADS_ENABLED=false

# Server-only configuration reserved for a future, approved integration vault.
# Do not add SUPABASE_SERVICE_ROLE_KEY to this application.
# These values belong only in the server runtime. Never prefix them with NEXT_PUBLIC_.
