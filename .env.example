# Public, non-secret Workspace configuration.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
NEXT_PUBLIC_WORKSPACE_SCHEMA=workspace
# Production uses https://workspace.leademergence.com. Preview and Development
# retain their exact environment-specific origins.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Exact custom OAuth/OIDC provider identifier configured in Workspace Supabase
# Auth for the canonical Lead Emergence Entry provider. This is server-only.
ENTRY_OIDC_PROVIDER=
# Exact OAuth protected-resource identifier advertised by Workspace MCP.
# Preview and Production must each use their own HTTPS origin.
WORKSPACE_MCP_RESOURCE_URI=http://localhost:3000/api/mcp
# Gate C must keep this false until the authenticated Storage API lifecycle test passes.
NEXT_PUBLIC_WORKSPACE_UPLOADS_ENABLED=false

# Server-only configuration reserved for a future, approved integration vault.
# Do not add SUPABASE_SERVICE_ROLE_KEY to this application.
# These values belong only in the server runtime. Never prefix them with NEXT_PUBLIC_.
# WORKSPACE_INTEGRATION_ENCRYPTION_KEY=
# WORKSPACE_INTEGRATION_STATE_SECRET=
# WORKSPACE_GOOGLE_OAUTH_CLIENT_ID=
# WORKSPACE_GOOGLE_OAUTH_CLIENT_SECRET=
# WORKSPACE_SLACK_OAUTH_CLIENT_ID=
# WORKSPACE_SLACK_OAUTH_CLIENT_SECRET=
# WORKSPACE_MONDAY_OAUTH_CLIENT_ID=
# WORKSPACE_MONDAY_OAUTH_CLIENT_SECRET=
# WORKSPACE_LINKEDIN_OAUTH_CLIENT_ID=
# WORKSPACE_LINKEDIN_OAUTH_CLIENT_SECRET=
# WORKSPACE_CANVA_OAUTH_CLIENT_ID=
# WORKSPACE_CANVA_OAUTH_CLIENT_SECRET=
# WORKSPACE_MICROSOFT_OAUTH_TENANT_ID=
# WORKSPACE_MICROSOFT_OAUTH_CLIENT_ID=
# WORKSPACE_MICROSOFT_OAUTH_CLIENT_SECRET=
# WORKSPACE_YOUVERSION_OAUTH_CLIENT_ID=
# WORKSPACE_YOUVERSION_OAUTH_CLIENT_SECRET=
# WORKSPACE_GITHUB_APP_ID=
# WORKSPACE_GITHUB_APP_PRIVATE_KEY=
# WORKSPACE_GITHUB_APP_SLUG=
# WORKSPACE_LOGOS_OAUTH_CONSUMER_KEY=
# WORKSPACE_LOGOS_OAUTH_CONSUMER_SECRET=
