{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "^/auth/callback$",
      "dest": "/auth/callback/index.html",
      "headers": "__SECURITY_HEADERS__"
    },
    {
      "src": ".*",
      "status": 404,
      "dest": "/404.html",
      "headers": "__INERT_HEADERS__"
    }
  ]
}
