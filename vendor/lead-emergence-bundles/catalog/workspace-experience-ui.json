{
  "schemaVersion": "1.0",
  "bundleKey": "workspace_experience",
  "workspaceRoute": { "route": "/workspace", "label": "Home" },
  "primaryNavigation": [
    { "id": "workspace.nav.home", "label": "Home", "route": "/workspace", "icon": "home", "order": 0, "capabilityId": "workspace.compose" }
  ],
  "secondaryNavigation": [
    { "id": "workspace.nav.search", "label": "Search", "route": "/workspace/search", "icon": "search", "order": 900, "capabilityId": "workspace.search" },
    { "id": "workspace.nav.attention", "label": "Attention", "route": "/workspace/attention", "icon": "clock", "order": 910, "capabilityId": "workspace.attention" },
    { "id": "workspace.nav.connections", "label": "Connections", "route": "/workspace/integrations", "icon": "plug", "order": 920, "capabilityId": "workspace.compose" },
    { "id": "workspace.nav.settings", "label": "Workspace layout", "route": "/workspace/layout", "icon": "settings", "order": 930, "capabilityId": "workspace.personalize" }
  ],
  "dashboardWidgets": [
    {
      "id": "workspace.widget.attention",
      "label": "What deserves attention",
      "order": 0,
      "type": "attention_composer",
      "capabilityId": "workspace.attention",
      "attentionTypes": ["workspace.attention.saved_work"],
      "emptyStateId": "workspace.empty.attention"
    }
  ],
  "quickActions": [
    {
      "id": "workspace.action.design",
      "label": "Recommend my workspace",
      "order": 90,
      "workflowId": "workspace.workflow.recommend_layout",
      "capabilityId": "workspace.personalize"
    }
  ],
  "searchProviders": [
    {
      "id": "workspace.search.global",
      "label": "All entitled workspaces",
      "order": 0,
      "capabilityId": "workspace.search",
      "resultTypes": ["workspace.result.navigation", "workspace.result.action"]
    }
  ],
  "commandPaletteActions": [
    {
      "id": "workspace.command.design",
      "label": "Recommend a workspace layout",
      "order": 90,
      "workflowId": "workspace.workflow.recommend_layout",
      "capabilityId": "workspace.personalize"
    }
  ],
  "notificationTypes": [
    {
      "id": "workspace.notification.connection_required",
      "label": "Connection needs attention",
      "order": 90,
      "capabilityId": "workspace.attention",
      "defaultEnabled": true
    }
  ],
  "emptyStates": [
    {
      "id": "workspace.empty.attention",
      "title": "No matching saved-work cues",
      "description": "This checks admitted saved-work metadata only. Try another source or priority; no matching cues is not an all-clear."

    }
  ],
  "bundleSettings": [
    {
      "id": "workspace.setting.ai_layout_recommendations",
      "label": "Allow AI layout recommendations",
      "order": 90,
      "type": "boolean",
      "required": false
    }
  ]
